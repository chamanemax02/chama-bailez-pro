{
    "name": "chama-bailez-pro",
    "version": "3.3.1",
    "description": "Ultra-lightweight WhatsApp Web API library with Low RAM Optimization, Pro features, Native Flow Interactive Buttons, Fullscreen Video/Voice VoIP Calling & Channel Poll Voting — built on Baileys. Powered by Chama OFC.",
    "publishConfig": {
        "access": "public"
    },
    "keywords": [
        "whatsapp",
        "js-whatsapp",
        "whatsapp-api",
        "whatsapp-web",
        "whatsapp-chat",
        "whatsapp-group",
        "whatsapp-bot",
        "baileys",
        "baileys-pro",
        "chama",
        "chama-bailez",
        "chama-ofc",
        "bot",
        "automation",
        "multi-device",
        "typescript",
        "voip",
        "calling",
        "auto-answer",
        "webrtc"
    ],
    "homepage": "https://www.npmjs.com/package/chama-bailez-pro",
    "repository": {
        "type": "git",
        "url": "https://github.com/chamanemax02/chama-bailez-pro.git"
    },
    "bugs": {
        "url": "https://github.com/chamanemax02/chama-bailez-pro/issues"
    },
    "license": "MIT",
    "author": {
        "name": "CHAMINDU OFC",
        "url": "https://github.com/chamanemax02"
    },
    "type": "module",
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "exports": {
        ".": {
            "types": "./lib/index.d.ts",
            "import": "./lib/index.js",
            "default": "./lib/index.js"
        },
        "./dist/*": "./dist/*",
        "./lib/*": "./lib/*",
        "./package.json": "./package.json"
    },
    "files": [
        "lib/**/*",
        "dist/**/*",
        "WAProto/**/*",
        "WASignalGroup/*.js",
        "assets/**/*",
        "engine-requirements.js",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build:all": "tsc && typedoc",
        "build:docs": "typedoc",
        "build:tsc": "tsc",
        "changelog:last": "conventional-changelog -p angular -r 2",
        "changelog:preview": "conventional-changelog -p angular -u",
        "changelog:update": "conventional-changelog -p angular -i CHANGELOG.md -s -r 0",
        "example": "node --inspect -r ts-node/register Example/example.ts",
        "gen:protobuf": "sh WAProto/GenerateStatics.sh",
        "lint": "eslint src --ext .js,.ts",
        "lint:fix": "yarn lint --fix",
        "preinstall": "node ./engine-requirements.js",
        "prepack": "echo ready",
        "prepare": "echo ready",
        "release": "release-it",
        "test": "jest",
        "start": "node --inspect -r ts-node/register Example/example.ts"
    },
    "dependencies": {
        "@adiwajshing/keyed-db": "^0.2.4",
        "@cacheable/node-cache": "^1.4.0",
        "@hapi/boom": "^9.1.3",
        "@roamhq/wrtc": "^0.10.0",
        "async-lock": "^1.4.1",
        "async-mutex": "^0.5.0",
        "audio-decode": "^2.1.3",
        "axios": "^1.6.0",
        "cache-manager": "^6.4.2",
        "chalk": "^4.1.2",
        "futoin-hkdf": "^1.5.1",
        "gradient-string": "^2.0.2",
        "libphonenumber-js": "^1.10.20",
        "libsignal": "^6.0.0",
        "lodash": "^4.17.21",
        "lru-cache": "^11.1.0",
        "music-metadata": "^11.12.3",
        "node-cache": "^5.1.2",
        "node-fetch": "^2.6.1",
        "p-queue": "^9.0.0",
        "pino": "^9.6.0",
        "protobufjs": "^7.5.6",
        "uuid": "^10.0.0",
        "whatsapp-rust-bridge": "0.5.4",
        "ws": "^8.13.0"
    },
    "devDependencies": {
        "@types/got": "^9.6.11",
        "@types/jest": "^27.5.1",
        "@types/node": "^22.13.10",
        "@types/sharp": "^0.29.4",
        "@types/ws": "^8.0.0",
        "conventional-changelog-cli": "^2.2.2",
        "eslint": "^8.0.0",
        "jest": "^27.0.6",
        "jimp": "^0.16.1",
        "json": "^11.0.0",
        "link-preview-js": "^3.0.0",
        "open": "^8.4.2",
        "qrcode-terminal": "^0.12.0",
        "release-it": "^15.10.3",
        "sharp": "^0.32.6",
        "ts-jest": "^27.0.3",
        "ts-node": "^10.8.1",
        "typedoc": "^0.24.7",
        "typescript": "^5.8.2"
    },
    "peerDependencies": {
        "jimp": "^0.16.1",
        "link-preview-js": "^3.0.0",
        "qrcode-terminal": "^0.12.0",
        "sharp": "^0.32.6"
    },
    "peerDependenciesMeta": {
        "jimp": {
            "optional": true
        },
        "link-preview-js": {
            "optional": true
        },
        "qrcode-terminal": {
            "optional": true
        },
        "sharp": {
            "optional": true
        }
    },
    "engines": {
        "node": ">=20.0.0"
    },
    "packageManager": "yarn@1.22.19"
}
